{
	"extends": "@tsconfig/node26/tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"noUncheckedIndexedAccess": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"allowJs": true,
		"checkJs": true,
		"types": ["node"]
	},
	"include": ["eslint.config.mjs", "types"]
}
