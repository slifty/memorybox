{
	"name": "memorybox",
	"version": "0.0.0",
	"private": true,
	"description": "Save a memory, view a memory",
	"scripts": {
		"format": "npm run format:eslint && npm run format:prettier",
		"format:eslint": "eslint . --fix || true",
		"format:prettier": "prettier . --write",
		"lint": "npm run lint:eslint && npm run lint:prettier && npm run lint:tsc",
		"lint:commit": "commitlint --from origin/main --to HEAD --verbose",
		"lint:eslint": "eslint . --max-warnings=0",
		"lint:prettier": "prettier . --check",
		"lint:tsc": "tsc -p tsconfig.json && tsc -p tsconfig.node.json"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/slifty/memorybox.git"
	},
	"bugs": {
		"url": "https://github.com/slifty/memorybox/issues"
	},
	"homepage": "https://github.com/slifty/memorybox#readme",
	"author": {
		"name": "Daniel Schultz",
		"email": "slifty@gmail.com",
		"url": "https://github.com/slifty"
	},
	"license": "AGPL-3.0",
	"devDependencies": {
		"@biffud/eslint-config": "~10.22.0",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@eslint-react/eslint-plugin": "^5.23.0",
		"@react-native/eslint-plugin": "^0.87.1",
		"@react-native/typescript-config": "^0.87.1",
		"@tsconfig/node24": "^24.0.5",
		"@types/node": "^24.19.0",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-react-hooks": "^7.1.1",
		"prettier": "3.9.9",
		"typescript": "~6.0.3"
	},
	"allowScripts": {
		"unrs-resolver": true
	}
}
