# Copy to .env to override. Expo inlines every EXPO_PUBLIC_ variable into the
# app bundle, so none of them may hold a secret.

# The Permanent API the app signs in against. Defaults to staging.
#   Production: https://app.permanent.org/api
#   Staging:    https://app.staging.permanent.org/api
#   Dev:        https://dev.permanent.org/api
EXPO_PUBLIC_PERMANENT_API_URL=https://app.staging.permanent.org/api

# Stela, Permanent's newer API, which serves archives and folder contents. It
# runs on its own host. Defaults to staging.
#   Production: https://api.permanent.org/api/v2
#   Staging:    https://api.staging.permanent.org/api/v2
EXPO_PUBLIC_PERMANENT_STELA_URL=https://api.staging.permanent.org/api/v2
